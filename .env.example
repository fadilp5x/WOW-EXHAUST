# GEMINI_API_KEY: Required for server-side Gemini privacy deduction explanations.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB Atlas connection string for 2-hour TTL report persistence (database: exhaust).
MONGODB_URI=""

# SESSION_SECRET: HMAC secret for signing anonymous HttpOnly session cookies.
SESSION_SECRET=""

# RATE_LIMIT_REDIS_URL & RATE_LIMIT_REDIS_TOKEN: Optional Upstash/Redis REST store for distributed rate limiting.
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""

# OPENSTREETMAP: Optional OpenStreetMap / tile API key used strictly server-side by /api/location/* endpoints.
OPENSTREETMAP=""

